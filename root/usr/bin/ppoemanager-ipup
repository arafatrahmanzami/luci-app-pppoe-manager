#!/bin/sh
# pppoemanager-ipup — record session baseline at PPP connect
# pppd args: $1=iface $2=internal-iface $3=unit $4=local-ip $5=peer-ip
IFACE="$1"
PEER="$5"
[ -z "$IFACE" ] && 
# Apply Rate Limiting via tc (HTB)
META_FILE="/lib/ppp/ppoemanager-meta"
if [ -f "$META_FILE" ] && command -v tc >/dev/null 2>&1; then
    RATES=$(awk -F'|' -v u="$USER" '$1 == u { print $11"|"$12 }' "$META_FILE")
    DL=$(echo "$RATES" | cut -d'|' -f1)
    UL=$(echo "$RATES" | cut -d'|' -f2)

    if [ -n "$DL" ] || [ -n "$UL" ]; then
        if [ -n "$DL" ]; then
            tc qdisc replace dev "$IFACE" root handle 1: htb default 10 2>/dev/null
            tc class replace dev "$IFACE" parent 1: classid 1:1 htb rate 1000mbit 2>/dev/null
            tc class replace dev "$IFACE" parent 1:1 classid 1:10 htb rate "${DL}kbit" ceil "${DL}kbit" 2>/dev/null
        fi
        if [ -n "$UL" ]; then
            modprobe ifb 2>/dev/null
            ip link set dev ifb0 up 2>/dev/null
            tc qdisc replace dev "$IFACE" handle ffff: ingress 2>/dev/null
            tc filter replace dev "$IFACE" parent ffff: protocol ip u32 match u32 0 0 action mirred egress redirect dev ifb0 2>/dev/null
            tc qdisc replace dev ifb0 root handle 1: htb default 10 2>/dev/null
            tc class replace dev ifb0 parent 1: classid 1:1 htb rate 1000mbit 2>/dev/null
            tc class replace dev ifb0 parent 1: classid 1:10 htb rate "${UL}kbit" ceil "${UL}kbit" 2>/dev/null
        fi
    fi
fi

exit 0
[ -z "$PEER" ] && 
# Apply Rate Limiting via tc (HTB)
META_FILE="/lib/ppp/ppoemanager-meta"
if [ -f "$META_FILE" ] && command -v tc >/dev/null 2>&1; then
    RATES=$(awk -F'|' -v u="$USER" '$1 == u { print $11"|"$12 }' "$META_FILE")
    DL=$(echo "$RATES" | cut -d'|' -f1)
    UL=$(echo "$RATES" | cut -d'|' -f2)

    if [ -n "$DL" ] || [ -n "$UL" ]; then
        if [ -n "$DL" ]; then
            tc qdisc replace dev "$IFACE" root handle 1: htb default 10 2>/dev/null
            tc class replace dev "$IFACE" parent 1: classid 1:1 htb rate 1000mbit 2>/dev/null
            tc class replace dev "$IFACE" parent 1:1 classid 1:10 htb rate "${DL}kbit" ceil "${DL}kbit" 2>/dev/null
        fi
        if [ -n "$UL" ]; then
            modprobe ifb 2>/dev/null
            ip link set dev ifb0 up 2>/dev/null
            tc qdisc replace dev "$IFACE" handle ffff: ingress 2>/dev/null
            tc filter replace dev "$IFACE" parent ffff: protocol ip u32 match u32 0 0 action mirred egress redirect dev ifb0 2>/dev/null
            tc qdisc replace dev ifb0 root handle 1: htb default 10 2>/dev/null
            tc class replace dev ifb0 parent 1: classid 1:1 htb rate 1000mbit 2>/dev/null
            tc class replace dev ifb0 parent 1: classid 1:10 htb rate "${UL}kbit" ceil "${UL}kbit" 2>/dev/null
        fi
    fi
fi

exit 0

SESSION_FILE="/lib/ppp/ppoemanager-session"
touch "$SESSION_FILE"

# Skip if an entry for this iface already exists
if grep -q "|$IFACE|" "$SESSION_FILE" 2>/dev/null; then
    
# Apply Rate Limiting via tc (HTB)
META_FILE="/lib/ppp/ppoemanager-meta"
if [ -f "$META_FILE" ] && command -v tc >/dev/null 2>&1; then
    RATES=$(awk -F'|' -v u="$USER" '$1 == u { print $11"|"$12 }' "$META_FILE")
    DL=$(echo "$RATES" | cut -d'|' -f1)
    UL=$(echo "$RATES" | cut -d'|' -f2)

    if [ -n "$DL" ] || [ -n "$UL" ]; then
        if [ -n "$DL" ]; then
            tc qdisc replace dev "$IFACE" root handle 1: htb default 10 2>/dev/null
            tc class replace dev "$IFACE" parent 1: classid 1:1 htb rate 1000mbit 2>/dev/null
            tc class replace dev "$IFACE" parent 1:1 classid 1:10 htb rate "${DL}kbit" ceil "${DL}kbit" 2>/dev/null
        fi
        if [ -n "$UL" ]; then
            modprobe ifb 2>/dev/null
            ip link set dev ifb0 up 2>/dev/null
            tc qdisc replace dev "$IFACE" handle ffff: ingress 2>/dev/null
            tc filter replace dev "$IFACE" parent ffff: protocol ip u32 match u32 0 0 action mirred egress redirect dev ifb0 2>/dev/null
            tc qdisc replace dev ifb0 root handle 1: htb default 10 2>/dev/null
            tc class replace dev ifb0 parent 1: classid 1:1 htb rate 1000mbit 2>/dev/null
            tc class replace dev ifb0 parent 1: classid 1:10 htb rate "${UL}kbit" ceil "${UL}kbit" 2>/dev/null
        fi
    fi
fi

exit 0
fi

# Look up user by peer IP
USER=$(awk -v ip="$PEER" '$4==ip && $1 !~ /^#/ { print $1; exit }' /etc/ppp/chap-secrets)
[ -z "$USER" ] && USER="?"

NOW=$(date +%s)
# Fresh interface: baseline is 0, current reading is whatever sysfs shows (usually 0)
RX=$(cat /sys/class/net/$IFACE/statistics/rx_bytes 2>/dev/null)
TX=$(cat /sys/class/net/$IFACE/statistics/tx_bytes 2>/dev/null)
[ -z "$RX" ] && RX=0
[ -z "$TX" ] && TX=0

# Format: pid|iface|ip|user|rx_base|tx_base|rx_last|tx_last|epoch
echo "0|$IFACE|$PEER|$USER|0|0|$RX|$TX|$NOW" >> "$SESSION_FILE"

# Apply Rate Limiting via tc (HTB)
META_FILE="/lib/ppp/ppoemanager-meta"
if [ -f "$META_FILE" ] && command -v tc >/dev/null 2>&1; then
    RATES=$(awk -F'|' -v u="$USER" '$1 == u { print $11"|"$12 }' "$META_FILE")
    DL=$(echo "$RATES" | cut -d'|' -f1)
    UL=$(echo "$RATES" | cut -d'|' -f2)

    if [ -n "$DL" ] || [ -n "$UL" ]; then
        if [ -n "$DL" ]; then
            tc qdisc replace dev "$IFACE" root handle 1: htb default 10 2>/dev/null
            tc class replace dev "$IFACE" parent 1: classid 1:1 htb rate 1000mbit 2>/dev/null
            tc class replace dev "$IFACE" parent 1:1 classid 1:10 htb rate "${DL}kbit" ceil "${DL}kbit" 2>/dev/null
        fi
        if [ -n "$UL" ]; then
            modprobe ifb 2>/dev/null
            ip link set dev ifb0 up 2>/dev/null
            tc qdisc replace dev "$IFACE" handle ffff: ingress 2>/dev/null
            tc filter replace dev "$IFACE" parent ffff: protocol ip u32 match u32 0 0 action mirred egress redirect dev ifb0 2>/dev/null
            tc qdisc replace dev ifb0 root handle 1: htb default 10 2>/dev/null
            tc class replace dev ifb0 parent 1: classid 1:1 htb rate 1000mbit 2>/dev/null
            tc class replace dev ifb0 parent 1: classid 1:10 htb rate "${UL}kbit" ceil "${UL}kbit" 2>/dev/null
        fi
    fi
fi

exit 0
