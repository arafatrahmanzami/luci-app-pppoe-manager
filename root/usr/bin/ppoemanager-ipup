#!/bin/sh
IFACE="$1"
PEER="$5"
[ -z "$IFACE" ] && exit 0
[ -z "$PEER" ] && exit 0

SESSION_FILE="/lib/ppp/ppoemanager-session"
touch "$SESSION_FILE"

# Get User
USER=$(awk -v ip="$PEER" '$4==ip && $1 !~ /^#/ { print $1; exit }' /etc/ppp/chap-secrets)
[ -z "$USER" ] && USER="?"

# Update Session File if not already there
if ! grep -q "|$IFACE|" "$SESSION_FILE" 2>/dev/null; then
    NOW=$(date +%s)
    RX=$(cat /sys/class/net/$IFACE/statistics/rx_bytes 2>/dev/null)
    TX=$(cat /sys/class/net/$IFACE/statistics/tx_bytes 2>/dev/null)
    [ -z "$RX" ] && RX=0
    [ -z "$TX" ] && TX=0
    echo "0|$IFACE|$PEER|$USER|0|0|$RX|$TX|$NOW" >> "$SESSION_FILE"
fi

# Apply Rate Limiting
META_FILE="/lib/ppp/ppoemanager-meta"
if [ -f "$META_FILE" ] && command -v tc >/dev/null 2>&1; then
    RATES=$(awk -F'|' -v u="$USER" '$1 == u { print $11"|"$12 }' "$META_FILE")
    DL=$(echo "$RATES" | cut -d'|' -f1)
    UL=$(echo "$RATES" | cut -d'|' -f2)

    if [ -n "$DL" ] || [ -n "$UL" ]; then
        # Egress (Download)
        if [ -n "$DL" ]; then
            tc qdisc replace dev "$IFACE" root handle 1: htb default 10
            tc class replace dev "$IFACE" parent 1: classid 1:1 htb rate 1000mbit
            tc class replace dev "$IFACE" parent 1:1 classid 1:10 htb rate "${DL}kbit" ceil "${DL}kbit"
        fi

        # Ingress (Upload)
        if [ -n "$UL" ]; then
            modprobe ifb 2>/dev/null
            if ! ip link show ifb0 >/dev/null 2>&1; then
                ip link add ifb0 type ifb
            fi
            ip link set dev ifb0 up

            tc qdisc replace dev "$IFACE" handle ffff: ingress
            tc filter replace dev "$IFACE" parent ffff: protocol ip u32 match u32 0 0 action mirred egress redirect dev ifb0

            tc qdisc replace dev ifb0 root handle 1: htb default 10
            tc class replace dev ifb0 parent 1: classid 1:1 htb rate 1000mbit
            tc class replace dev ifb0 parent 1: classid 1:10 htb rate "${UL}kbit" ceil "${UL}kbit"
        fi
    fi
fi
exit 0
